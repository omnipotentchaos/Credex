# Environment variables — copy to .env.local and fill in your own values.
# Never commit .env.local or paste real secrets into this example file.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cerebras API (for AI-generated summaries)
CEREBRAS_API_KEY=your_cerebras_api_key

# Resend (API Keys in dashboard)
RESEND_API_KEY=your_resend_api_key

# App (production: your Vercel URL)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Upstash Redis — rate limits for /api/* (optional in dev; recommended in prod)
# Create a database at https://console.upstash.com/ → REST API → copy URL + token
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
